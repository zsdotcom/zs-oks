{
  "name": "open-knowledge-studio",
  "version": "1.0.0",
  "description": "Zero-dependency, browser-native, multi-agent AI platform for offline-first research, writing, and data analysis",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bench": "vitest bench",
    "test:bench:compare": "vitest bench --compare benchmark-results.json"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "fake-indexeddb": "^6.0.1",
    "happy-dom": "^16.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.4"
  }
}
# Open Knowledge Studio v1.0 — Environment Variables
# Copy this file to .env and fill in your API keys.
# All keys are optional — the app works with any combination of providers.
# Never commit your .env file — it is excluded by .gitignore.

# ─── Google Gemini API Key (Required for Coordinator & Writer agents) ───
# Get free key at: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1M TPM, 1500 RPD
VITE_GEMINI_API_KEY=

# ─── Groq API Key (Required for Researcher agent) ───
# Get free key at: https://console.groq.com/keys
# Free tier: 30 RPM, 6K TPM
VITE_GROQ_API_KEY=

# ─── Cerebras API Key (Optional, backup provider) ───
# Get free key at: https://cloud.cerebras.ai/
# Free tier: 15 RPM
VITE_CEREBRAS_API_KEY=

# ─── DeepSeek API Key (Optional, fallback provider) ───
# Get free key at: https://platform.deepseek.com/api_keys
# Free tier: 5 RPM
VITE_DEEPSEEK_API_KEY=

# ─── Google Cloud Client ID (Optional, for Drive/Docs integration) ───
# Get from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID → Web Application
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ─── OpenRouter API Key (Optional, unified access to multiple models) ───
# Get free key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# ─── Anthropic API Key (Optional) ───
# Get from: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=

# ─── OpenAI API Key (Optional) ───
# Get from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# ─── GitHub Token (Optional, for repository integration) ───
# Get from: https://github.com/settings/tokens
VITE_GITHUB_TOKEN=

# ─── Notes ───
# - API keys can also be entered at runtime via the Settings Panel GUI.
# - Keys entered in the GUI are stored in IndexedDB, not in this file.
# - Never commit your .env file — it is excluded by .gitignore.
# - The app uses a Smart Router to select the best provider automatically.
# - All VITE_* env vars are exposed to client-side code via Vite's define.

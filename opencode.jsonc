{
  "$schema": "https://opencode.ai/config.json",

  // ─── System Instructions ───
  // Loads AGENTS.md into the AI's system prompt every launch
  "instructions": ["AGENTS.md"],

  // ─── Skills ───
  // Register both skill directories so /skill command can discover them
  "skills": {
    "paths": [".opencode/skills"]
  },

  // ─── References ───
  // Local directories available as supporting context via @ alias
  "references": {
    "docs": {
      "path": "docs",
      "description": "Product documentation and user guides (105+ files)"
    },
    "data": {
      "path": "docs/_data",
      "description": "Canonical project variables (version, stats, URLs)"
    },
    "infra": {
      "path": ".github",
      "description": "CI/CD workflows, CODEOWNERS, issue templates"
    }
  },

  // ─── MCP Servers ───
  // These connect the AI to external tools and services
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@context7/mcp-server"],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-playwright"]
    }
  },

  // ─── Subagent Settings ───
  "subagent_depth": 3,

  // ─── Tool & Execution Permissions ───
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git commit *": "ask",
      "git push *": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "${workspaceFolder}/**": "allow",
      "*": "deny"
    }
  }
}

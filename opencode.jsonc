{
  "$schema": "https://opencode.ai/config.json",

  // ─── System Instructions ───
  // OpenCode loads these markdown files into the LLM system prompt on launch
  "instructions": [
    "AGENTS.md"
  ],

  // ─── Subagent Settings ───
  // Maximum nesting depth for subagent delegation
  "subagent_depth": 3,

  // ─── Tool & Execution Permissions ───
  // Governs what the AI agent can execute automatically vs. requiring manual approval
  "permission": {
    // Basic file inspection tools
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",

    // File editing permissions
    "edit": "allow",

    // Terminal / Bash permissions
    "bash": {
      "*": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git commit *": "ask",
      "git push *": "ask"
    },

    // Web capabilities
    "webfetch": "allow",
    "websearch": "allow",

    // Strictly lock filesystem interaction to this repository root
    "external_directory": {
      "/home/codeandbrain/open-knowledge-studio/**": "allow",
      "*": "deny"
    }
  }
}
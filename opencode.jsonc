{
  "$schema": "https://opencode.ai/config.json",

  // ─── System Instructions ───
  // Loads AGENTS.md into the AI's system prompt on every launch
  "instructions": ["AGENTS.md"],

  // ─── References ───
  // Local project directories made available as supporting context (@ alias)
  "references": {
    "docs": {
      "path": "docs",
      "description": "Product documentation and user guides"
    },
    "data": {
      "path": "docs/_data",
      "description": "Canonical project variables (version, stats, URLs)"
    },
    "infra": {
      "path": ".github",
      "description": "CI/CD workflows, CODEOWNERS, issue templates"
    }
  },

  // ─── MCP Servers ───
  // Connects OpenCode to external tools and services
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@context7/mcp-server"],
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic/mcp-playwright"]
    }
  },

  // ─── Subagent Settings ───
  "subagent_depth": 3,

  // ─── Tool & Execution Permissions ───
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git commit *": "ask",
      "git push *": "ask"
    }
  }
}

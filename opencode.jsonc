{
  "$schema": "https://opencode.ai/config.json",

  // ─── System Instructions ───
  "instructions": ["AGENTS.md"],

  // ─── Model ───
  "model": "anthropic/claude-sonnet-4-6",
  "small_model": "anthropic/claude-haiku-4-5",

  // ─── Default Agent ───
  "default_agent": "build",

  // ─── References ───
  // Local project directories made available as supporting context (@ alias)
  "references": {
    "docs": {
      "path": "docs",
      "description": "Product documentation and user guides"
    },
    "data": {
      "path": "docs/_data",
      "description": "Canonical project variables (version, stats, URLs)"
    },
    "infra": {
      "path": "infrastructure",
      "description": "Agentic infrastructure: agents, tools, workflows, knowledge"
    },
    "github": {
      "path": ".github",
      "description": "CI/CD workflows, CODEOWNERS, issue templates"
    }
  },

  // ─── MCP Servers ───
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"]
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  },

  // ─── Agents ───
  "agent": {
    "repository-maintainer": {
      "description": "Maintains repo health: CI/CD, deps, linting, code quality. Use for repo-wide fixes, dependency updates, CI debugging.",
      "mode": "subagent",
      "permission": {
        "bash": "allow",
        "edit": "allow"
      }
    }
  },

  // ─── Commands ───
  "command": {
    "deploy": {
      "description": "Build the project and prepare for deployment",
      "template": "Run the full build pipeline: typecheck → test → build. If all pass, summarize the output and confirm readiness for deployment. Project: Open Knowledge Studio (React + Vite + TypeScript)."
    },
    "test": {
      "description": "Run tests with optional filter pattern",
      "template": "Run npm test{{#if .}} -- -t \"{{.}}\"{{/if}} and report the results. If any tests fail, diagnose and fix the issues before reporting success.",
      "subtask": true
    },
    "typecheck": {
      "description": "Run TypeScript type checking",
      "template": "Run npm run typecheck and report any errors. If errors are found, analyze and fix them.",
      "subtask": true
    },
    "build": {
      "description": "Full production build with verification",
      "template": "Run the complete CI pipeline in order: npm run typecheck, npm test, npm run build. If any step fails, fix the issue before proceeding to the next step. Report final build output.",
      "subtask": false
    }
  },

  // ─── Subagent Settings ───
  "subagent_depth": 3,

  // ─── Tool & Execution Permissions ───
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git commit *": "ask",
      "git push *": "ask"
    },
    "external_directory": {
      "/tmp/opencode": "allow",
      "*": "ask"
    }
  }
}

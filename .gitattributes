# Normalize line endings for all text files
* text=auto

# Source code — LF line endings
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.html text eol=lf

# Documentation — LF line endings, markdown diff
*.md text eol=lf diff=markdown
*.yml text eol=lf
*.yaml text eol=lf

# Config files
*.env text eol=lf
*.conf text eol=lf
*.toml text eol=lf
*.jsonc text eol=lf

# Lock files — binary diff
package-lock.json linguist-generated=true

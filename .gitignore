
# =============================================================================
# Open Knowledge Studio — .gitignore
# =============================================================================

# --- OS / Editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
*.~
*~

# --- IDE ---
.idea/
*.iml
.vscode/*.log

# --- Environment Variables (contains secrets — NEVER commit) ---
.config.template.md
.env
.env.development
.env.local
.env.production

# --- Dependencies ---
node_modules/

# --- Build Output ---
dist/
coverage/
*.tsbuildinfo
tsconfig.tsbuildinfo

# --- Agent / Runtime ---
.opencode_history
.opencode/*
!.opencode/skills/
.opencode/skills/*
!.opencode/skills/*/
session-*.md
benchmark-results.json

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Temporary Files ---
tmp/
temp/
*.tmp
*.temp

# --- Testing ---
test-results/
/e2e-results/
/playwright-report/
playwright/.cache/

# --- Generated / Ejected ---
public/models/
Open Knowledge Studio_files/
Open Knowledge Studio.html

# --- Workspace (local only) ---
.workspace/

# --- Package Manager Lockfiles (keep package-lock.json) ---
pnpm-lock.yaml
yarn.lock
_github_docs-main

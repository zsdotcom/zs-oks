{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost:3000",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src",
      "pathMapping": { "/src/*": "${workspaceFolder}/src/*" }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Vitest",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run TypeCheck",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "typecheck"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}

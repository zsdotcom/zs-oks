{
  "httpHeaders": [
    {
      "urls": ["https://github.com/", "https://guides.github.com/", "https://help.github.com/"],
      "headers": {
        "Accept-Encoding": "zstd, br, gzip, deflate"
      }
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^(/zs-oks/)",
      "replacement": "{{BASEURL}}/"
    }
  ],
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 301, 302, 303, 307, 429],
  "ignorePatterns": [
    {
      "pattern": "^https?://localhost"
    },
    {
      "pattern": "^https?://127.0.0.1"
    },
    {
      "pattern": "^https?://sandbox.fhir.dghs.gov.bd"
    },
    {
      "pattern": "^https?://zarishsphere\\.com"
    }
  ]
}
